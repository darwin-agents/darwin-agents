# =============================================================================
# Darwin platform — environment / credentials template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored — it never leaves your machine.
#
#   cp .env.example .env
#   set -a; source .env; set +a      # export everything, then:
#   darwin-platform serve --db state.db
#
# This file is the SINGLE source of truth for both run paths:
#   - bare CLI:  set -a; source .env; set +a; darwin-platform serve ...
#   - Compose:   cd docker && cp ../.env.example .env && docker compose up
#
# STATUS LEGEND — each variable is tagged:
#   [Required]  the supervisor cannot boot a useful Darwin without this.
#   [Optional]  has an in-process fallback (fake adapter / sqlite / local
#               denylist / etc.); set it only when you want the real thing.
#
# Sections are ordered from most to least critical for a production deploy.
# Block-level tags apply to every variable in the block unless overridden.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM — model providers                                          [Required]
# -----------------------------------------------------------------------------
# At least one provider key is required — without it the genome has no brain.
# Tiers used by the supervisor:
#   Anthropic  — reasoning / coding   (primary, required for the default loop)
#   OpenAI     — embeddings / fallback
#   Gemini     — fast / cheap tier
# When the LiteLLM proxy is configured (block 2) the proxy holds these keys
# and the values here are unused at runtime.
CLAUDE_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...


# -----------------------------------------------------------------------------
# 2. LiteLLM proxy — caching, rate limits, per-Darwin spend          [Optional]
# -----------------------------------------------------------------------------
# Self-hosted LiteLLM proxy in front of the providers above. Activate with
# `--litellm-url $URL --litellm-master-key $KEY`; the docker-compose stack
# bundles one at http://litellm:4000. With these set the genome's LLM
# transport routes every call through the proxy (cache + rate-limit +
# per-Darwin spend accounting). Strongly recommended for production.
DARWIN_LITELLM_URL=http://localhost:4000
# Generate a new key with: openssl rand -hex 32 | sed 's/^/sk-litellm-master-/'
DARWIN_LITELLM_MASTER_KEY=sk-litellm-master-...


# -----------------------------------------------------------------------------
# 3. Persistence & caching                                            [varies]
# -----------------------------------------------------------------------------
# Postgres — production persistence.                                 [Required
# for production; the CLI falls back to a local SQLite file when omitted.]
DATABASE_URL=postgresql://darwin_admin:dev_only_password@localhost:5432/darwin_db

# Postgres service credentials for the docker-compose stack.          [Required
# if you run `docker compose up`; ignored by the bare CLI path.]
POSTGRES_USER=darwin_admin
POSTGRES_PASSWORD=dev_only_password
POSTGRES_DB=darwin_db

# Redis — backs the LiteLLM proxy's response cache and cross-replica
# rate limits (litellm.config.yaml reads these).                      [Required
# if you enable LiteLLM (block 2); otherwise optional. docker-compose
# bundles a `redis` service and defaults host=redis.]
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_only_password

# LanceDB — per-Darwin episodic vector memory, one subdirectory per       [Optional]
# darwin_id under this path. Activate with
# `--episodic-memory lancedb --lancedb-path "$DARWIN_LANCEDB_PATH"`;
# without the flag the genome uses its deterministic in-process default
# (preserves sim + cross-engine parity).
DARWIN_LANCEDB_PATH=/data/lancedb


# -----------------------------------------------------------------------------
# 4. Per-Darwin wallet — on-chain settlement                          [varies]
# -----------------------------------------------------------------------------
# Three providers, selected by --wallet-provider:
#
#   cdp          DEFAULT. Per-Darwin Coinbase CDP account; the private key
#                lives in Coinbase's TEE and never enters this process.
#                Each spawn gets its own on-chain address via
#                get_or_create_account(name="darwin-{id}"). Production
#                default for Base / EVM. Requires the [cdp] extra.
#
#   local-vault  Per-Darwin keypair minted at spawn and sealed in the
#                Darwin's vault namespace under sensitive/wallet/<chain>/.
#                Self-custodial — bytes are in this process while the chain
#                client is constructed, then live only in the vault. Use
#                for chains CDP doesn't cover (Solana, Stellar). Needs the
#                chain's [solana] / [stellar] / [web3] extra and the matching
#                RPC URL below; no secret env var needed.
#
#   web3         Single shared private key from env, signs for every Darwin
#                on the platform. TESTNET DEV SHORTCUT — refuses to start
#                when an RPC URL contains "mainnet" or points at
#                horizon.stellar.org.

# Coinbase CDP — production default. The CDP SDK auto-reads these       [Required
# names. Add --cdp-mainnet to use base-mainnet (defaults to base-sepolia).  for
# production on-chain; optional if you stick to local-vault or web3.]
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# RPC URLs — used by local-vault for chain client construction (no       [Optional]
# secret env required; the keypair is minted into the per-Darwin vault).
# Also used by the web3 shortcut when --wallet-provider web3 is selected.
# Pass --chain-networks=base,solana,stellar to enable the chains you want.
DARWIN_RPC_URL=https://sepolia.base.org
DARWIN_SOLANA_RPC_URL=https://api.devnet.solana.com
DARWIN_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Shared private keys — TESTNET ONLY, used by --wallet-provider web3.    [Optional]
# Leave blank unless you have a specific reason to share one key across
# the whole fleet (single-tenant dev / CI). The CLI refuses to start with
# these set against a mainnet RPC URL. Prefer cdp or local-vault.
# DARWIN_WALLET_KEY=0x...
# DARWIN_SOLANA_WALLET_KEY=
# DARWIN_STELLAR_SECRET=S...


# -----------------------------------------------------------------------------
# 5. Compute substrates — sandbox & browser                          [Optional]
# -----------------------------------------------------------------------------
# E2B microVM sandbox — isolated code execution for the sandbox neuron.
# Without a key the supervisor falls back to a local subprocess sandbox.
E2B_API_KEY=

# Browserbase — remote browser runtime for the browser.operator neuron
# (default; --browser-provider browserbase). The OSS browser_use library
# runs in-process and drives this runtime over CDP.
BROWSERBASE_URL=https://api.browserbase.com
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Browser Use Cloud V3 Agent — alternative to Browserbase. The cloud
# orchestrates the agent loop *and* the browser; we send a task and
# receive a result. Activate with `--browser-provider browser-use-cloud`
# (+ optional `--browser-use-model` for the BU custom model). Requires
# the [browser-use-cloud] extra. See docs/engineering/31-browser-use-evaluation.md.
BROWSER_USE_API_KEY=


# -----------------------------------------------------------------------------
# 6. Platform auth — owner / operator API access                      [varies]
# -----------------------------------------------------------------------------
# Bearer tokens for the control-plane API. Two paths:
#   1. Static tokens via `--auth-tokens path/to/tokens.json` — a JSON file
#      listing tokens + scopes + owned darwins. Fine for dev/CI; no env
#      vars required.
#   2. Clerk-issued RS256 JWTs verified against the JWKS — production.
#      Activate with `--clerk-issuer $ISSUER --clerk-jwks-url $JWKS_URL`.
#      `ClerkTokenStore` maps claims → scopes and keeps per-user Darwin
#      ownership keyed by Clerk user id.                              [Required
# for production; optional if you use static tokens via --auth-tokens.]
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=


# -----------------------------------------------------------------------------
# 7. Secrets store — HashiCorp Vault                                  [Optional]
# -----------------------------------------------------------------------------
# Holds per-Darwin sensitive material (wallet keys when --wallet-provider
# local-vault, rotated provider keys, etc.). Without these the supervisor
# uses an in-process fake vault — fine for dev, never for production.
# In production use AppRole / k8s-auth, not a root token.
DARWIN_VAULT_URL=http://localhost:8200
DARWIN_VAULT_TOKEN=


# -----------------------------------------------------------------------------
# 8. Fiat ramps — deposit / withdraw at the platform edge            [Optional]
# -----------------------------------------------------------------------------
# Stripe fiat ramp — card / ACH deposits + Stripe Connect (Express)
# withdrawals. Activate with `--fiat-provider stripe`. Requires the
# [stripe] extra.
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MoonPay fiat ramp — alternative to Stripe; HTTP-only, no extra needed.
# Activate with `--fiat-provider moonpay`.
MOONPAY_API_KEY=pk_test_...
MOONPAY_SECRET_KEY=sk_test_...


# -----------------------------------------------------------------------------
# 9. Sanctions / compliance screening                                [Optional]
# -----------------------------------------------------------------------------
# Chainalysis OR TRM Labs API key. Also pass:
#   --sanctions-provider {chainalysis,trm}
# Default `local` uses an offline denylist and needs no key.
DARWIN_SANCTIONS_API_KEY=


# -----------------------------------------------------------------------------
# 10. KYC / identity verification                                    [Optional]
# -----------------------------------------------------------------------------
# Persona — adapter `PersonaKYCProvider` is wired. Default KYC provider.
DARWIN_KYC_PERSONA_API_KEY=persona_...

# Onfido — second KYC provider (alternative to Persona). Activate with
# `--kyc-provider onfido`. Region: EU | US | CA.
ONFIDO_API_TOKEN=
ONFIDO_REGION=EU
ONFIDO_WORKFLOW_ID=


# -----------------------------------------------------------------------------
# 11. Notifications & escalations                                    [Optional]
# -----------------------------------------------------------------------------
# Slack incoming webhook — owner notifications.
DARWIN_SLACK_WEBHOOK_URL=

# Generic JSON webhooks — escalation tickets and monitor alerts.
DARWIN_ESCALATION_WEBHOOK_URL=
DARWIN_ALERT_WEBHOOK_URL=

# PagerDuty Events v2 routing key — critical alerts page on-call.
DARWIN_PAGERDUTY_ROUTING_KEY=

# Firebase Cloud Messaging — mobile push. The project id is read today;
# FCM HTTP v1 also needs a service-account JSON — point
# GOOGLE_APPLICATION_CREDENTIALS at its path.
DARWIN_FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/fcm-service-account.json

# Twilio — the platform SMS 2FA inbox (doc 15). Setting the SID + token
# enables it; codes are read via GET /platform/sms/verification-code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# -----------------------------------------------------------------------------
# 12. Observability                                                  [Optional]
# -----------------------------------------------------------------------------
# OpenTelemetry — traces export (Jaeger / OTel collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
