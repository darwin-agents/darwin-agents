# =============================================================================
# Darwin platform — environment / credentials template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored — it never leaves your machine.
#
#   cp .env.example .env
#   set -a; source .env; set +a      # export everything, then:
#   darwin-platform serve --db state.db
#
# This file is the SINGLE source of truth for both run paths:
#   - bare CLI:  set -a; source .env; set +a; darwin-platform serve ...
#   - Compose:   cd docker && cp ../.env.example .env && docker compose up
#
# STATUS LEGEND — read this before filling anything in:
#   [LIVE]     the supervisor reads this today; set it and it works.
#   [PENDING]  the adapter is written but not yet hooked to a CLI flag / env var;
#              a small wiring task makes it [LIVE].
#   [TO BUILD] P2: no adapter exists yet. The variable name is PROVISIONAL — the
#              adapter, when built, decides the final name. Setting it does
#              nothing until that adapter lands.
#
# Every integration is opt-in: leave a block blank and the supervisor falls back
# to the in-process fake for that capability.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — model providers
# -----------------------------------------------------------------------------
# [LIVE] Consumed by LiteLLM (in-process today; the proxy below is P2).
# Tiers: Anthropic = reasoning/coding, OpenAI = embeddings/fallback, Gemini = fast.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# [PENDING] Self-hosted LiteLLM proxy (P2 — TODO "LiteLLM self-hosted proxy").
# DARWIN_LITELLM_URL points the genome's transport at a running proxy instead of
# in-process litellm.completion. Master key authenticates to the proxy.
DARWIN_LITELLM_URL=http://localhost:4000
DARWIN_LITELLM_MASTER_KEY=sk-litellm-master-...


# -----------------------------------------------------------------------------
# Per-Darwin wallet — on-chain settlement
# -----------------------------------------------------------------------------
# [LIVE] Base / EVM (primary USDC rail). Wallet key signs transfers locally.
DARWIN_RPC_URL=https://sepolia.base.org
DARWIN_WALLET_KEY=0x...

# [LIVE] Solana fallback rail (also pass --chain-networks=base,solana).
DARWIN_SOLANA_RPC_URL=https://api.devnet.solana.com
DARWIN_SOLANA_WALLET_KEY=

# [LIVE] Stellar fallback rail (also pass --chain-networks=...,stellar).
DARWIN_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
DARWIN_STELLAR_SECRET=S...

# [TO BUILD] Coinbase CDP / Agentic Wallet (P2 — replaces the raw-private-key
# RealWallet with a TEE-secured CDP wallet). The CDP SDK auto-reads these names.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# [TO BUILD] AWS Bedrock AgentCore Payments (P2 — secondary payment rail).
# Uses the AWS credentials block further below; this is the agent handle.
DARWIN_AGENTCORE_PAYMENT_AGENT_ID=


# -----------------------------------------------------------------------------
# Fiat ramps — deposit / withdraw at the platform edge
# -----------------------------------------------------------------------------
# [LIVE] Stripe — adapter `StripeFiatRamp` exists; needs CLI/env wiring in
# __main__.py. Connect (Express) is used for withdrawals.
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# [LIVE] MoonPay — adapter `MoonPayFiatRamp` exists; needs CLI/env wiring.
MOONPAY_API_KEY=pk_test_...
MOONPAY_SECRET_KEY=sk_test_...


# -----------------------------------------------------------------------------
# Sanctions / compliance screening
# -----------------------------------------------------------------------------
# [LIVE] Chainalysis OR TRM Labs. Also pass: --sanctions-provider {chainalysis,trm}
# (default `local` uses an offline denylist and needs no key).
DARWIN_SANCTIONS_API_KEY=


# -----------------------------------------------------------------------------
# KYC / identity verification
# -----------------------------------------------------------------------------
# [LIVE] Persona — adapter `PersonaKYCProvider` is wired.
DARWIN_KYC_PERSONA_API_KEY=persona_...

# [LIVE] Onfido — second KYC provider (P2). Region: EU | US | CA.
ONFIDO_API_TOKEN=
ONFIDO_REGION=EU
ONFIDO_WORKFLOW_ID=


# -----------------------------------------------------------------------------
# Secrets store — HashiCorp Vault
# -----------------------------------------------------------------------------
# [LIVE] In production use AppRole / k8s-auth, not a root token.
DARWIN_VAULT_URL=http://localhost:8200
DARWIN_VAULT_TOKEN=


# -----------------------------------------------------------------------------
# Compute substrates — sandbox & browser
# -----------------------------------------------------------------------------
# [LIVE] E2B microVM sandbox.
E2B_API_KEY=

# [LIVE] Browserbase — remote browser runtime for the browser.operator neuron.
BROWSERBASE_URL=
BROWSERBASE_API_KEY=

# [TO BUILD] Modal — secondary sandbox runtime (P2). SDK auto-reads these names.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# [TO BUILD] Northflank — alternative sandbox runtime (P2).
NORTHFLANK_API_TOKEN=


# -----------------------------------------------------------------------------
# Persistence & caching
# -----------------------------------------------------------------------------
# [LIVE] Postgres — production persistence (omit for the SQLite dev default).
DATABASE_URL=postgresql://darwin:password@localhost:5432/darwin

# [LIVE] Redis — the LiteLLM proxy's response cache + cross-replica rate
# limits (litellm.config.yaml reads these). docker-compose bundles a `redis`
# service and defaults host=redis; leave blank for the in-process CLI path.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# [LIVE] LanceDB — per-Darwin episodic vector memory. Embedded (one
# subdirectory per darwin_id under DARWIN_LANCEDB_PATH). Activate with
# `--episodic-memory lancedb --lancedb-path "$DARWIN_LANCEDB_PATH"`; the
# genome stays on its deterministic in-process default when the flag is
# absent (sim + cross-engine parity preserved).
DARWIN_LANCEDB_PATH=/data/lancedb


# -----------------------------------------------------------------------------
# Durable jobs
# -----------------------------------------------------------------------------
# [TO BUILD] Temporal (P2 — durable billing / harvest / reproduce jobs).
# Temporal Cloud: API-key auth, address is <namespace>.<acct>.tmprl.cloud:7233.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=


# -----------------------------------------------------------------------------
# Platform auth — owner / operator API access
# -----------------------------------------------------------------------------
# [LIVE] Bearer tokens for the control-plane API. Today these are passed via the
# `--auth-tokens` CLI flag / a tokens file; in production use Clerk or WorkOS.
#
# [TO BUILD] Clerk (P2 — pick ONE of Clerk / WorkOS). Token verification reads
# the JWKS; derive CLERK_JWKS_URL from your Clerk domain if you prefer.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# [TO BUILD] WorkOS (P2 — the alternative to Clerk).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=


# -----------------------------------------------------------------------------
# Notifications & escalations
# -----------------------------------------------------------------------------
# [LIVE] Slack incoming webhook — owner notifications.
DARWIN_SLACK_WEBHOOK_URL=

# [LIVE] Generic JSON webhooks — escalation tickets and monitor alerts.
DARWIN_ESCALATION_WEBHOOK_URL=
DARWIN_ALERT_WEBHOOK_URL=

# [LIVE] PagerDuty Events v2 routing key — critical alerts page on-call.
DARWIN_PAGERDUTY_ROUTING_KEY=

# [LIVE] Firebase Cloud Messaging — mobile push. The project id is read today;
# FCM HTTP v1 also needs a service-account JSON — point GOOGLE_APPLICATION_
# CREDENTIALS at its path.
DARWIN_FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/fcm-service-account.json

# [LIVE] Twilio — the platform SMS 2FA inbox (doc 15). Setting the SID +
# token enables it; codes are read via GET /platform/sms/verification-code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# [LIVE] OpenTelemetry — traces export (Jaeger / OTel collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# AWS — shared credentials (Bedrock AgentCore + CloudWatch, both P2)
# -----------------------------------------------------------------------------
# [TO BUILD] One AWS identity backs both AgentCore Payments and CloudWatch.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


# -----------------------------------------------------------------------------
# docker-compose stack — Postgres service credentials (dev defaults)
# -----------------------------------------------------------------------------
POSTGRES_USER=darwin
POSTGRES_PASSWORD=dev_only_password
POSTGRES_DB=darwin
