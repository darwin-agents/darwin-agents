# Darwin web dashboard — example environment

# Platform REST + WebSocket origin. Dev default points at `darwin-platform serve`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Dev-only bearer token for the in-memory platform TokenStore.
# Leave blank in production — Clerk's getToken() supplies the JWT.
NEXT_PUBLIC_DEV_BEARER_TOKEN=

# Clerk (production). Backend already accepts Clerk RS256 JWTs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: pinned Darwin id for storybook-like preview pages.
NEXT_PUBLIC_PREVIEW_DARWIN_ID=
