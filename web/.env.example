# Darwin web dashboard — example environment

# Platform REST + WebSocket origin. Dev default points at `darwin-platform serve`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Dev-only bearer token for the in-memory platform TokenStore.
# Leave blank in production — Clerk's getToken() supplies the JWT.
NEXT_PUBLIC_DEV_BEARER_TOKEN=

# Clerk (production). Backend already accepts Clerk RS256 JWTs.
# When the publishable key is set, the dashboard switches from the dev
# token-paste flow to Clerk-gated sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Point Clerk at the in-app sign-in/sign-up routes (set these whenever the
# publishable key above is set). Without them Clerk redirects to its hosted
# accounts.dev portal — works, but adds a third-party hop.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional: pinned Darwin id for storybook-like preview pages.
NEXT_PUBLIC_PREVIEW_DARWIN_ID=
