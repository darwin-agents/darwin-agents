/**
 * HashiCorp Vault — local dev mode.
 *
 * Dev mode = in-memory storage, auto-unsealed, with a known root token.
 * Suitable ONLY for the local stack. A production deployment swaps this
 * module for one that uses raft storage + KMS auto-unseal + tighter
 * RBAC; the variables that matter (address, root token Secret) stay
 * compatible so the downstream platform module doesn't change.
 *
 * The root token is generated by random_password rather than the chart's
 * hardcoded default so two parallel local stacks (e.g. dev + smoke)
 * can't clobber each other's auth.
 */

resource "kubernetes_namespace" "this" {
  metadata {
    name = var.namespace
    labels = {
      "app.kubernetes.io/part-of" = "darwin"
    }
  }
}

resource "random_password" "root_token" {
  length  = 32
  special = false # vault root tokens must be URL-safe
}

resource "helm_release" "vault" {
  name             = "vault"
  repository       = "https://helm.releases.hashicorp.com"
  chart            = "vault"
  version          = var.chart_version
  namespace        = kubernetes_namespace.this.metadata[0].name
  create_namespace = false
  atomic           = true
  timeout          = 600

  values = [yamlencode({
    server = {
      dev = {
        enabled      = true
        devRootToken = random_password.root_token.result
      }
      logLevel = "info"
      # Disable readiness probe — dev mode is ready as soon as the
      # process is up; the chart's default probe expects the API to
      # answer the sealed-state question and adds a few seconds of
      # boot lag in dev mode.
      readinessProbe = {
        enabled = false
      }
    }
    injector = {
      enabled = false
    }
    csi = {
      enabled = false
    }
    ui = {
      enabled = true
    }
  })]
}
