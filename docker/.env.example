# Provider API keys for the local dev stack. Copy to docker/.env and
# fill in your real keys; .env is .dockerignore'd and .gitignore'd so it
# never leaves your machine.

# Anthropic — Claude tier (reasoning + coding)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — embeddings + fallback reasoning
OPENAI_API_KEY=sk-...

# Google Gemini — fast tier
GEMINI_API_KEY=AI...

# Postgres credentials are dev-only in docker-compose.yml. Override
# below if you swap to an external Postgres for testing.
POSTGRES_USER=darwin
POSTGRES_PASSWORD=dev_only_password
POSTGRES_DB=darwin
